KAFKA_BOOTSTRAP_SERVER=localhost:9092
KAFKA_TRANSACTION_TOPIC=payment_transaction_events
KAFKA_USER_TOPIC=payment_user_events
KAFKA_ALERT_TOPIC=payment_risk_alerts
KAFKA_METRIC_TOPIC=payment_realtime_metrics
KAFKA_LATE_TOPIC=payment_late_events
KAFKA_DLT_TOPIC=payment_dead_letter_events
