KAFKA_BOOTSTRAP_SERVER=localhost:9092
KAFKA_TRANSACTION_TOPIC=payment_transaction_events
FLINK_UI=http://localhost:8081
FLINK_PARALLELISM=2
CHECKPOINT_DIR=file:///tmp/finguard-checkpoints

# Optional model provider. If unset, the service uses deterministic fallback mode.
OPENAI_API_KEY=
FINGUARD_AI_MODEL=gpt-5-mini

# AI reliability / audit controls.
FINGUARD_AI_DB_PATH=data/ai_copilot/finguard_ai.sqlite3
FINGUARD_AI_FAILURE_THRESHOLD=3
FINGUARD_AI_COOLDOWN_SECONDS=30
FINGUARD_AI_MAX_CONCURRENCY=4
FINGUARD_AI_BULKHEAD_WAIT_MS=25
FINGUARD_CORS_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
