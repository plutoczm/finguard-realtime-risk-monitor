{
  "version": 2,
  "framework": null,
  "outputDirectory": "dashboard/static",
  "rewrites": [
    { "source": "/api/dashboard", "destination": "/api/dashboard.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
